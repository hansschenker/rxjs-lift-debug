{
  "name": "rxjs-lift-debug",
  "version": "0.1.0",
  "private": true,
  "description": "RxJS 7.8.2 lift debugger analysis and a verified teaching recorder",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/verify.cjs",
    "example": "npm run build && node dist/examples/basic.js"
  },
  "dependencies": {
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
